# Site-specific build settings. Copy to ops/rebuild.env and fill in.
#
#   cp ops/rebuild.env.example ops/rebuild.env
#
# ops/rebuild.env is gitignored and MUST stay that way: this fork is public.
# Nothing in this file belongs in a commit.

# Container registry host to push to. No default in the repo, on purpose --
# without this, `--push` fails loudly rather than publishing somewhere unintended.
KARAKEEP_REGISTRY=registry.example.com

# Repository path within the registry.
#KARAKEEP_IMAGE_REPO=karakeep/karakeep

# Product label stamped into SERVER_VERSION and shown in the sidebar.
# The build SHA is appended automatically, e.g. "Karakeep Acme (d6f6672c)".
#KARAKEEP_BRAND=Karakeep

# Resource caps -- lower these if the build is crowding the host.
#KARAKEEP_BUILDER_MEM=8g
#KARAKEEP_BUILDER_CPUS=0-7
#KARAKEEP_TEST_THREADS=4
